{
  "name": "conquest",
  "version": "2.0.0",
  "description": "Pellagos: a fantasy action role-playing game in the browser, with a hero and orcs built from MakeHuman's body, in a generated town drawn in real-time 3D.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "world-server": "node server/world.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "e2e:durations": "node scripts/e2e-durations.js",
    "lint": "eslint .",
    "check": "npm run lint && npm test",
    "check:motion": "node scripts/motion-check.js",
    "balance": "node scripts/balance.js",
    "step-budget": "node scripts/step-budget.js",
    "soak": "node scripts/soak.js",
    "soak:server": "node scripts/server-soak.js",
    "snapshot-fixture": "node scripts/snapshot-fixture.js",
    "vendor:three": "node scripts/vendor-three.js",
    "vendor:meshopt": "node scripts/vendor-meshopt.js",
    "vendor:qrcode": "node scripts/vendor-qrcode.js",
    "vendor:ed25519": "node scripts/vendor-ed25519.js",
    "build:manifest": "node scripts/build-manifest.js",
    "build:characters": "node scripts/build-characters.js",
    "build:vitruvian": "node scripts/build-vitruvian.js",
    "build:music": "node scripts/build-music.js",
    "build:sounds": "node scripts/build-sounds.js",
    "build:props": "node scripts/build-props.js",
    "build:textures": "node scripts/build-textures.js",
    "build:clips": "node scripts/build-clips.js",
    "build:footprints": "node scripts/build-footprints.js",
    "build:mac": "node scripts/build-mac-app.js",
    "release-key": "node scripts/release-key.js",
    "vendor:recast": "node scripts/vendor-recast.js"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@eslint/js": "^9.39.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "^2.4.0",
    "@playwright/test": "^1.56.1",
    "@recast-navigation/core": "^0.43.1",
    "@recast-navigation/generators": "^0.43.1",
    "@recast-navigation/wasm": "^0.43.1",
    "@wasm-audio-decoders/flac": "^0.2.11",
    "@wasm-audio-decoders/ogg-vorbis": "^0.1.20",
    "draco3dgltf": "^1.5.7",
    "esbuild": "0.28.2",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jpeg-js": "^0.4.4",
    "libarchive-wasm": "^1.2.0",
    "meshoptimizer": "^1.3.0",
    "mpg123-decoder": "^1.0.3",
    "qrcode-generator": "^2.0.4",
    "three": "0.186.0"
  }
}
