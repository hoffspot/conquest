{
  "name": "blenderpipeline",
  "version": "1.0.0",
  "description": "Turns .blend files into game-ready glTF (GLB) for Pellagos's Three.js: meshes, materials baked to one atlas, every animation, compressed, checked and reported on.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node setup.js",
    "build": "node build.js examples/*.json",
    "fixtures": "node build.js --fixtures",
    "view": "node viewer/serve.js",
    "test": "node --test test/*.test.js",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.56.1",
    "gltf-validator": "2.0.0-dev.3.10",
    "meshoptimizer": "1.3.0",
    "three": "0.186.0"
  }
}
